<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- UpgradeCode must never change: it lets new versions replace old ones (and GPO upgrades work). -->
  <Package Name="Claude Status"
           Manufacturer="Claude Status contributors"
           Version="$(var.Version)"
           UpgradeCode="3cfb7184-5671-4234-bda5-0a6928ef18ef"
           Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Claude Status is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- AUTOSTART=0 skips the all-users autostart entry (msiexec /i ClaudeStatus-x64.msi AUTOSTART=0, or via a transform for GPO). -->
    <Property Id="AUTOSTART" Value="1" />
    <Icon Id="AppIcon.exe" SourceFile="$(var.PublishDir)/ClaudeStatus.exe" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.exe" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPURLINFOABOUT" Value="https://claude.ai/settings/usage" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Claude Status">
        <Component Id="MainExecutable">
          <File Id="ClaudeStatusExe" Source="$(var.PublishDir)/ClaudeStatus.exe" KeyPath="yes">
            <!-- Advertised shortcut: valid for a per-machine package (ICE38/43/57). -->
            <Shortcut Id="ClaudeStatusShortcut" Directory="ProgramMenuFolder" Name="Claude Status"
                      Description="Claude usage on the taskbar" WorkingDirectory="INSTALLFOLDER" Advertise="yes" Icon="AppIcon.exe" />
          </File>
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Component Id="AutoStartAllUsers" Condition="AUTOSTART = 1" Guid="6f1d2a4e-0f5b-4a37-9a0e-2b8d4c7f1e93">
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="ClaudeStatus"
                       Type="string" Value="&quot;[INSTALLFOLDER]ClaudeStatus.exe&quot;" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main" Title="Claude Status">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="AutoStartAllUsers" />
    </Feature>
  </Package>
</Wix>
