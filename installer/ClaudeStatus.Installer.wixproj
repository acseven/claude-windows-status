<Project Sdk="WixToolset.Sdk/5.0.2">
  <!--
    Per-machine MSI for GPO Software Installation / Intune / SCCM.
    Build after publishing the app:
      dotnet publish src/ClaudeStatus -c Release -r win-x64 -o publish/win-x64
      dotnet build installer -c Release -p:Platform=x64 -p:PublishDir=../publish/win-x64 -p:Version=26.10.1 -p:DisplayVersion=2026.10.1
  -->
  <PropertyGroup>
    <!-- Version = MSI ProductVersion (YY.M.n, major must be <= 255); DisplayVersion = YYYY.M.n. -->
    <Version Condition="'$(Version)' == ''">26.1.0</Version>
    <DisplayVersion Condition="'$(DisplayVersion)' == ''">$(Version)</DisplayVersion>
    <OutputName>ClaudeStatus-$(DisplayVersion)-$(Platform)</OutputName>
    <PublishDir Condition="'$(PublishDir)' == ''">../publish/win-$(Platform)</PublishDir>
    <DefineConstants>Version=$(Version);DisplayVersion=$(DisplayVersion);PublishDir=$(PublishDir)</DefineConstants>
    <SuppressValidation>false</SuppressValidation>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>
